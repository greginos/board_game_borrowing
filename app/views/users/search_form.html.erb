<div class='app'>
    <h2>Rechercher un utilisateur</h2>

    <%= form_with url: users_path, method: :get, local: true do |form| %>
    <div>
        <%= form.label :email, "Email de l'utilisateur" %>
        <%= form.text_field :email, placeholder: "ex: john.doe@email.com" %>
    </div>
    <div>
        <%= form.label :pseudo, "Pseudo de l'utilisateur" %>
        <%= form.text_field :pseudo, placeholder: "ex: Barbie31" %>
    </div>

    <div>
        <%= form.submit "Rechercher" %>
    </div>
    <% end %>

</div>
