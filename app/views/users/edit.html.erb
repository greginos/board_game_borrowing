<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h2>Modifier mon profil</h2>
        </div>
        <div class="card-body">
          <%= form_with(model: @user, local: true, class: "edit-profile-form", html: { multipart: true }) do |f| %>
            <div class="mb-3">
              <%= f.label :pseudo, class: "form-label" %>
              <%= f.text_field :pseudo, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4 %>
            </div>

            <div class="mb-3">
              <%= f.label :avatar, "Photo de profil", class: "form-label" %>
              <%= f.file_field :avatar, class: "form-control", accept: "image/*" %>
              <% if @user.avatar.attached? %>
                <div class="mt-2">
                  <%= image_tag @user.avatar, class: "current-avatar", alt: "Avatar actuel" %>
                </div>
              <% end %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "Retour", user_path(@user), class: "btn btn-secondary" %>
              <%= f.submit "Enregistrer les modifications", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div> 