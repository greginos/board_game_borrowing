<header>
  <div class="header-left">
    <%= link_to root_path do %>
      <h1> Jeux à em'<strong>portet</strong></h1>
    <% end %>
  </div>
  <div class="header-right">
    <div class="search" data-controller="search">
      <%= form_with url: board_games_path, method: :get, class: "search-form" do %>
        <%= text_field_tag :query,
              params[:query],
              class: "search-input",
              placeholder: "Rechercher un jeu...",
              data: { search_target: "input" }
        %>
        <button type="submit" class="search-button">
          <svg class="icon-search" width="20" height="20" viewBox="0 0 20 20">
            <use xlink:href="#ico-search"></use>
          </svg>
        </button>
      <% end %>
    </div>
    <% if user_signed_in? %>
      <div class="dropdown">
        <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <%= image_tag current_user.avatar_url, class: "avatar", alt: "avatar" %>
        </a>
        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
          <%= link_to "Mon profil", user_path(current_user), class: "dropdown-item" %>
          <%= link_to "Ajouter un jeu", board_games_scan_board_games_path, class: "dropdown-item" %>
          <%= link_to "Ajouter un ami", search_form_users_path, class: "dropdown-item" %>
          <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, data: {turbo_method: :delete}, class: "dropdown-item" %>
        </div>
      </div>
    <% else %>
      <%= link_to "Connexion", new_user_session_path %>
    <% end %>
  </div>
</header>
