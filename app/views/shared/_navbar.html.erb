<header>
  <div class="header-left">
    <%= link_to root_path do %>
      
      <h1> <%= image_tag "/icon.png", class: "logo",style: "height: 1.5em;" %> 
        <% unless signed_in? && request.user_agent =~ /Mobile|webOS/ %>
          <span>Jeux à em'<strong>portet</strong></span>
        <% end %>
      </h1>
    <% end %>
  </div>
  <div class="header-right">
    <%
=begin%>
 <div class="search" data-controller="search">
      <%= form_with url: board_games_path, method: :get, class: "search-form" do %>
        <%= text_field_tag :query,
              params[:query],
              class: "search-input",
              placeholder: "Rechercher un jeu...",
              data: { search_target: "input" }
        %>
        <button type="submit" class="search-button">
          <svg class="icon-search" width="20" height="20" viewBox="0 0 20 20">
            <use xlink:href="#ico-search"></use>
          </svg>
        </button>
      <% end %>
    </div> 
<%
=end%>
    <% if user_signed_in? %>
      <div class="nav-icons">
        <%= link_to user_path(current_user) do %>
          <div class="position-relative">
            <i class="bi bi-person-circle"></i>
            <% if current_user.pending_borrowings_count > 0 %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">
                <%= current_user.pending_borrowings_count %>
              </span>
            <% end %>
          </div>
        <% end %>
        <%= link_to board_games_scan_board_games_path do %>
          <i class="bi bi-plus-circle"></i>
        <% end %>
        <%= link_to conversations_path do %>
          <div class="position-relative">
            <i class="bi bi-chat-dots"></i>
            <% if current_user.unread_messages_count > 0 %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">
                <%= current_user.unread_messages_count %>
              </span>
            <% end %>
          </div>
        <% end %>
        <%= link_to search_form_users_path do %>
          <i class="bi bi-person-plus"></i>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false } do %>
          <i class="bi bi-box-arrow-right"></i>
        <% end %>
      </div>
      <div class="dropdown">
        <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <%= image_tag current_user.avatar_url, class: "avatar", alt: "avatar" %>
        </a>
        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
          <%= link_to user_path(current_user), class: "dropdown-item" do %>
            <div class="d-flex align-items-center">
              <i class="bi bi-person-circle me-2"></i>
              <span>Mon profil</span>
              <% if current_user.pending_borrowings_count > 0 %>
                <span class="badge rounded-pill bg-warning ms-auto">
                  <%= current_user.pending_borrowings_count %>
                </span>
              <% end %>
            </div>
          <% end %>
          <%= link_to board_games_scan_board_games_path, class: "dropdown-item" do %>
            <i class="bi bi-plus-circle me-2"></i>
            <span>Ajouter un jeu</span>
          <% end %>
          <%= link_to conversations_path, class: "dropdown-item" do %>
            <div class="d-flex align-items-center">
              <i class="bi bi-chat-dots me-2"></i>
              <span>Mes messages</span>
              <% if current_user.unread_messages_count > 0 %>
                <span class="badge rounded-pill bg-warning ms-auto">
                  <%= current_user.unread_messages_count %>
                </span>
              <% end %>
            </div>
          <% end %>
          <%= link_to search_form_users_path, class: "dropdown-item" do %>
            <i class="bi bi-person-plus me-2"></i>
            <span>Ajouter un ami</span>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "dropdown-item" do %>
            <i class="bi bi-box-arrow-right me-2"></i>
            <span>Déconnexion</span>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= link_to "Connexion", new_user_session_path %>
    <% end %>
  </div>
</header>
