<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">
            Conversation avec <%= @conversation.other_user(current_user).pseudo %>
          </h5>
          <%= link_to conversations_path, class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-arrow-left"></i> Retour
          <% end %>
        </div>
        <div class="card-body">
          <div class="messages-container" style="height: 400px; overflow-y: auto;">
            <% @conversation.messages.each do |message| %>
              <div class="message <%= message.from == current_user ? 'message-sent' : 'message-received' %> mb-3">
                <div class="message-content p-3 rounded">
                  <p class="mb-0"><%= message.text %></p>
                  <small class="text-muted">
                    <%= message.created_at.strftime("%d/%m/%Y %H:%M") %>
                  </small>
                </div>
              </div>
            <% end %>
          </div>

          <%= form_with(model: [@conversation, Message.new], local: true, class: "mt-3", data: { turbo: false }) do |f| %>
            <div class="input-group">
              <%= f.text_area :text, class: "form-control", placeholder: "Écrivez votre message...", rows: 2 %>
              <%= f.submit "Envoyer", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.message {
  max-width: 70%;
}

.message-sent {
  margin-left: auto;
}

.message-received {
  margin-right: auto;
}

.message-sent .message-content {
  background-color: #007bff;
  color: white;
}

.message-received .message-content {
  background-color: #f8f9fa;
}

.messages-container {
  border: 1px solid #dee2e6;
  border-radius: 0.25rem;
  padding: 1rem;
}
</style> 