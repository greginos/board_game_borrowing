<div class="app">
    <div class="container mt-4">
        <% unless (@board_game.ean || @game_list.present?) %>
            <%= form_with url: board_games_scan_board_games_path, method: :get, local: true, class: "mb-3" do %>
                <div class="mb-3">
                    <%= label_tag :ean, "Code-barres du jeu", class: "form-label" %>
                    <%= text_field_tag :ean, params[:ean], class: "form-control" %>
                    <%= submit_tag "Rechercher", class: "btn btn-primary" %>
                </div>
            <% end %>
        <% end %>

        <% if @game_list.present? %>
            <%= render "board_games/game_list" %>
        <% end %>

        <% if @board_game.id.present? %>
            <div class="board_game">
                <div class="poster">
                    <img src=<%= @board_game.image_link %> alt="" class="poster" />
                </div>
                <div class="info-container">
                    <div class="title"><%=@board_game.name %></div>
                    <div class="info">
                        <span class="length">Code barre : <%= @board_game.ean %></span>
                    <div class="info">
                        <span class="year">Nombre de joueurs : <%= @board_game.min_players%>-<%= @board_game.max_players%> </span> 
                    </div>
                    <div class="info">
                        <span class="year">A partir de : <%= @board_game.minimum_age %> ans </span> 
                    </div>
                    <div class="info">
                        <span class="year">Durée : <%= @board_game.length %></span> 
                    </div>
                </div>
                <div class="desc">
                    <%= @board_game.description %>    
                </div>
            </div>
            <%= form_with(model: @board_game, url: board_games_scan_board_games_path, method: :post, local: true, class: "mb-3") do |form| %>
                <%= form.hidden_field :id, value: @board_game.id %>
                <div class="mb-3">
                    <%= form.label :etat_du_jeu, class: "form-label" %>
                    <%= form.select :game_state, ["Neuf", "Très bon état", "Bon état", "Correct", "Médiocre"], {}, class: "form-select" %>
                </div>

                <div class="d-flex gap-2">
                    <%= form.submit "Enregistrer le jeu", class: "btn btn-primary" %>
                </div>
                <div class="d-flex gap-2">
                    <%= form.submit "Enregistrer et ajouter un autre", name: "add_another", class: "btn btn-secondary" %>
                </div>    
            <% end %>
        <% elsif @board_game.ean || flash[:alert] == "Aucune information trouvée pour ce jeu."%>
            <%= form_with(model: @board_game, url: scan_board_games_path, method: :post, local: true, class: "mb-3") do |form| %>
                <% if @board_game.errors.any? %>
                    <div class="alert alert-danger">
                        <h2><%= pluralize(@board_game.errors.count, "error") %> erreurs empêchent l'enregistrement :</h2>
                        <ul>
                            <% @board_game.errors.full_messages.each do |message| %>
                                <li><%= message %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>

                <div class="mb-3">
                    <%= form.label :nom_du_jeu, class: "form-label" %>
                    <%= form.text_field :name, value: @board_game.name, class: "form-control" %>
                </div>

                <div class="mb-3">
                    <%= form.label :image, class: "form-label" %>
                    <% if @board_game.image_link.present? %>
                        <div class="mt-2">
                            <%= image_tag @board_game.image_link, alt: "Image du jeu", class: "img-fluid", style: "max-width: 200px; max-height: 200px;" %>
                        </div>
                    <% else %>
                        <%= form.text_field :image, placeholder: "Ajouter le lien de l'image", class: "form-control" %>
                    <% end %>
                    <%= form.hidden_field :image_link, value: @board_game.image_link %>
                </div>

                <div class="mb-3">
                    <%= form.label :nombre_minimum_de_joueurs, class: "form-label" %>
                    <%= form.number_field :min_players, value: @board_game.min_players, class: "form-control" %>
                </div>

                <div class="mb-3">
                    <%= form.label :nombre_maximum_de_joueurs, class: "form-label" %>
                    <%= form.number_field :max_players, value: @board_game.max_players, class: "form-control" %>
                </div>
                
                <div class="mb-3">
                    <%= form.label :age_minimum, class: "form-label" %>
                    <%= form.number_field :minimum_age, value: @board_game.minimum_age, class: "form-control" %>
                </div>

                <div class="mb-3">
                    <%= form.label :duree_d_une_partie, class: "form-label" %>
                    <%= form.text_field :length, value: @board_game.length, class: "form-control" %>
                </div>

                <div class="mb-3">
                    <%= form.label :description, class: "form-label" %>
                    <%= form.text_field :description, value: @board_game.description, class: "form-control" %>
                </div>

                <div class="mb-3">
                    <%= form.label :etat_du_jeu, class: "form-label" %>
                    <%= form.select :game_state, ["Neuf", "Très bon état", "Bon état", "Correct", "Médiocre"], {}, class: "form-select" %>
                </div>

                <div class="mb-3">
                    <%= form.label :code_barres, class: "form-label" %>
                    <%= form.text_field :ean, value: @board_game.ean, placeholder: "Saisissez ou scannez un EAN", class: "form-control" %>
                </div>

                <div class="d-flex gap-2">
                    <%= form.submit "Enregistrer le jeu", class: "btn btn-primary" %>
                </div>
                <div class="d-flex gap-2">
                    <%= form.submit "Enregistrer et ajouter un autre", name: "add_another", class: "btn btn-secondary" %>
                </div>
            <% end %>
        <% end %>
    </div>
</div>