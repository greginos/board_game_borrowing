<div class="app">
    <div class="detail">
        <%= form_with url: board_games_scan_board_games_path, method: :get, local: true do %>
        <div class="field">
            <%= label_tag :ean, "Code-barres du jeu" %>
            <%= text_field_tag :ean, params[:ean] %>
            <%= submit_tag "Rechercher" %>
        </div>
        <% end %>
        
        <% if @board_game.ean || flash[:alert] == "Aucune information trouvée pour cet EAN."%>
            <%= form_with(model: @board_game, url: board_games_scan_board_games_path, local: true) do |form| %>
            <% if @board_game.errors.any? %>
                <div id="error_explanation">
                <h2><%= pluralize(@board_game.errors.count, "error") %> erreurs empêchent l'enregistrement :</h2>
                <ul>
                    <% @board_game.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                    <% end %>
                </ul>
                </div>
            <% end %>

            <div class="field">
                <%= form.label :code_barres %>
                <%= form.text_field :ean, value: @board_game.ean, placeholder: "Saisissez ou scannez un EAN" %>
            </div>

            <div class="field">
                <%= form.label :nom_du_jeu %>
                <%= form.text_field :name, value: @board_game.name %>
            </div>

            <div class="field">
                <%= form.label :image %>
                <% if @board_game.image_link.present? %>
                <br>
                <%= image_tag @board_game.image_link, alt: "Image du jeu", style: "max-width: 200px; max-height: 200px;" %>
                <% else %>
                <%= form.text_field :image, placeholder: "Ajouter le lien de l'image" %>
                <% end %>
                <%= form.hidden_field :image_link, value: @board_game.image_link %>
            </div>

            <div class="field">
                <%= form.label :nombre_minimum_de_joueurs %>
                <%= form.number_field :min_players, value: @board_game.min_players %>
            </div>

            <div class="field">
                <%= form.label :nombre_maximum_de_joueurs %>
                <%= form.number_field :max_players, value: @board_game.max_players %>
            </div>
            
            <div class="field">
                <%= form.label :age_minimum %>
                <%= form.number_field :minimum_age, value: @board_game.minimum_age %>
            </div>

            <div class="field">
                <%= form.label :duree_d_une_partie %>
                <%= form.text_field :length, value: @board_game.length %>
            </div>

            <div class="field">
                <%= form.label :description %>
                <%= form.text_field :description, value: @board_game.description %>
            </div>
            

            <div class="field">
                <%= form.label :etat_du_jeu %>
                <%= form.select :game_state, ["Neuf", "Très bon état", "Bon état", "Correct", "Médiocre"] %>
            </div>

            <div class="actions">
                <%= form.submit "Enregistrer le jeu" %>
            </div>
            <% end %>
        <% end %>
    </div>
</div>
