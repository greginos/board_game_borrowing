<div class="app">
    <div class="board_game">
        <div class="favorite-button">
            <%= button_to update_favorites_path, 
                params: { id: current_user.id, favorite_id: @board_game.id },
                method: :post,
                class: "text-decoration-none border-0 bg-transparent",
                data: { turbo: false } do %>
                <% if current_user && current_user.favorites.include?(@board_game.id) %>
                    <svg width="2em" height="2em" viewBox="0 0 24 24" fill="#ff9d3e" stroke="#ff9d3e" stroke-width="2" stroke-linecap="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                <% else %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24" fill="none" stroke="grey" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                <% end %>
            <% end %>
        </div>
        <div class="poster">
            <img src=<%= @board_game.image_link %> alt="" class="poster" />
        </div>
        <div class="info-container">
            <div class="title"><%=@board_game.name %></div>
            <div class="info">
                <span class="length">Code barre : <%= @board_game.ean %></span>
            <div class="info">
                <span class="year">Nombre de joueurs : <%= @board_game.min_players%>-<%= @board_game.max_players%> </span> 
            </div>
            <div class="info">
                <span class="year">A partir de : <%= @board_game.minimum_age %> ans </span> 
            </div>
            <div class="info">
                <span class="year">Durée : <%= @board_game.length %></span> 
            </div>
        </div>
        <div class="desc">
            <%= @board_game.description %>    
        </div>
        <% if current_user && !current_user.board_games.include?(@board_game) %>
        <div class="borrowers">
            <% if @board_game.games.from_friends(current_user).any? %>
                <h3>Emprunter ce jeu à :</h3>
                <% @board_game.games.from_friends(current_user).each do |game| %>
                <%= link_to new_game_borrowing_path(game.id), class: "text-decoration-none" do %>
                    <div class="user-card">
                        <%= image_tag game.user.avatar_url, class: "avatar", alt: "avatar", style: "width: 50px; height: 50px;" %>
                        <span class="ms-2"><%= game.user.pseudo %></span>
                    </div>
                    <% end %>
                <% end %>
            <% else %>
                <h5>Aucun ami n'a ce jeu à vous prêter</h5>
            <% end %>
        </div>
        <% end %>
    </div>
</div>
