<div class="container mt-4">
  <div class="row">
    <div class="col-md-6">
      <h2>Informations légales</h2>
      <div class="card mb-4">
        <div class="card-body">
          <h3>Hébergement</h3>
          <p>Ce site est hébergé par IONOS SE</p>
          <p>Elgendorfer Str. 57</p>
          <p>56410 Montabaur</p>
          <p>Allemagne</p>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <h2>Contact</h2>
      <div class="card">
        <div class="card-body">
          <%= form_with url: contact_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, "Nom", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :subject, "Sujet", class: "form-label" %>
              <%= f.text_field :subject, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :message, "Message", class: "form-label" %>
              <%= f.text_area :message, class: "form-control", rows: 5, required: true %>
            </div>

            <%= f.submit "Envoyer", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div> 