<div class="app">
  <h4>Emprunt du jeu : <%= @board_game.name %> <%= image_tag @board_game.image_link, style: "width: 50px; height: 50px;" %></h4>
  <h5>à <%= @borrowing.game.user.pseudo %> <%= image_tag @borrowing.game.user.avatar_url, class: "avatar", alt: "avatar", style: "width: 50px; height: 50px;" %></h5>

  <%= simple_form_for([@board_game, @borrowing]) do |f| %>
    <div class="form-group">
      <%= f.input :start_date, as: :string, input_html: { type: 'date' }, label: "Date de début" %>
    </div>

    <div class="form-group">
      <%= f.input :end_date, as: :string, input_html: { type: 'date' }, label: "Date de fin" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Enregistrer", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>